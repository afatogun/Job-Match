# Copy to .env (or paste the key into Settings in the app, which writes this file).
# Not used until step 13 - job discovery works without it.
OPENAI_API_KEY=

# Optional storage controls for tiny hosts (EC2 micro).
JOBMATCH_AUTO_CLEANUP_ON_START=true
JOBMATCH_VACUUM_ON_CLEANUP=true
JOBMATCH_RETENTION_REFRESH_RUNS_DAYS=30
JOBMATCH_RETENTION_GENERATED_DAYS=21
JOBMATCH_RETENTION_UPLOADS_DAYS=14
